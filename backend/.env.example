# ─── Required ────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
MONGO_URI=mongodb://localhost:27017/bookops

# ─── Admin Portal ────────────────────────────────────────
ADMIN_EMAIL=admin@bookops.com
ADMIN_PASSWORD=your_admin_password

# ─── Stripe (optional — enables paid bookings) ────────────
STRIPE_SECRET_KEY=

# ─── Brevo Email (optional — enables OTP & booking emails) 
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=BookOps
EMAIL_FROM=

# ─── Google Calendar (optional — enables calendar sync) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback

# ─── Frontend URL (for Stripe redirects) ─────────────────
CLIENT_URL=http://localhost:5173
